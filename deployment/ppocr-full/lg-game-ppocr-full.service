[Unit]
Description=LG full-frame PP-OCR on Orange
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ppocr-full-experiment-20261009
Environment=LD_LIBRARY_PATH=%h/lg-game-ocr-runtime/assets:%h/lg-game-ocr-runtime/assets/sysroot/usr/lib/aarch64-linux-gnu
Environment=OMP_THREAD_LIMIT=1
Environment=PP_OCR_POLICY_LIBRARY=%h/ppocr-full-experiment-20261009/libpiccap_ocr_policy.so
Environment=PP_OCR_CTC_LIBRARY=%h/ppocr-native-ctc-experiment-20261010/build/libppocr_ctc.so
Environment=PP_OCR_EXACT_CROP_CACHE=1
ExecStart=%h/lg-game-ocr-runtime/.venv/bin/python -B serve-ppocr-frame-probe.py --library detector-build/libppocr_detector_replay.so --detector-prefix %h/ppocr-full-experiment-20261009/PP_OCRv5_mobile_det --runtime %h/lg-game-ocr-runtime --gocr-runtime %h/ppocr-full-experiment-20261009/transport-runtime --token-file %h/gocr-runtime/transport.token --bind 192.168.1.11 --port 18775
Restart=on-failure
RestartSec=3
UMask=0077
StandardOutput=append:%h/ppocr-full-experiment-20261009/server.log
StandardError=append:%h/ppocr-full-experiment-20261009/server.log

[Install]
WantedBy=default.target
