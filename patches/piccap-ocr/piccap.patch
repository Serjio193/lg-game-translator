diff --git a/scripts/package.py b/scripts/package.py
new file mode 100644
index 0000000..940fa5e
--- /dev/null
+++ b/scripts/package.py
@@ -0,0 +1,62 @@
+"""Build an IPK and preserve executable modes when packaging from Windows."""
+
+import io
+import json
+import pathlib
+import subprocess
+import tarfile
+
+
+def fix_modes(path):
+    archive = path.read_bytes()
+    if archive[:8] != b"!<arch>\n":
+        raise ValueError("Invalid ar package")
+    rebuilt = bytearray(archive[:8])
+    offset = 8
+    fixed = set()
+    executables = {"hyperion-webos", "piccapautostart", "setuplegacylogging.sh"}
+    while offset < len(archive):
+        header = bytearray(archive[offset:offset + 60])
+        size = int(header[48:58])
+        data = archive[offset + 60:offset + 60 + size]
+        name = header[:16].decode("ascii").strip().rstrip("/")
+        if name == "data.tar.gz":
+            output = io.BytesIO()
+            with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as source:
+                with tarfile.open(fileobj=output, mode="w:gz", format=tarfile.GNU_FORMAT) as target:
+                    for member in source:
+                        parts = pathlib.PurePosixPath(member.name).parts
+                        if ("org.webosbrew.piccap.service" in parts
+                                and member.name.rsplit("/", 1)[-1] in executables
+                                and member.isfile()):
+                            member.mode = 0o755
+                            fixed.add(parts[-1])
+                        target.addfile(member, source.extractfile(member) if member.isfile() else None)
+            data = output.getvalue()
+        header[48:58] = str(len(data)).encode("ascii").ljust(10, b" ")
+        rebuilt.extend(header)
+        rebuilt.extend(data)
+        if len(data) % 2:
+            rebuilt.extend(b"\n")
+        offset += 60 + size + size % 2
+    if fixed != executables:
+        raise ValueError(f"Missing service executables: {executables - fixed}")
+    temporary = path.with_suffix(".ipk.tmp")
+    temporary.write_bytes(rebuilt)
+    temporary.replace(path)
+    print(f"Verified executable modes 0755: {', '.join(sorted(fixed))}")
+
+
+def main():
+    root = pathlib.Path(__file__).resolve().parents[1]
+    version = json.loads((root / "frontend/appinfo.json").read_text())["version"]
+    subprocess.run([
+        "node", str(root / "node_modules/@webosose/ares-cli/bin/ares-package.js"),
+        str(root / "build/piccap-frontend"), str(root / "build/hyperion-webos"),
+        "-o", str(root / "build"),
+    ], check=True, cwd=root)
+    fix_modes(root / f"build/org.webosbrew.piccap_{version}_all.ipk")
+
+
+if __name__ == "__main__":
+    main()
