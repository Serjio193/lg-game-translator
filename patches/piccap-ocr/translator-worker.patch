diff --git a/unicapture/translator_worker.c b/unicapture/translator_worker.c
new file mode 100644
index 0000000..7502f35
--- /dev/null
+++ b/unicapture/translator_worker.c
@@ -0,0 +1,283 @@
+#define _POSIX_C_SOURCE 200809L
+
+#include "translator_worker.h"
+#include "log.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <netdb.h>
+#include <unistd.h>
+
+#define TRANSLATOR_HOST "192.168.1.11"
+#define TRANSLATOR_PORT "8765"
+#define TRANSLATOR_PATH "/api/translate"
+#define TRANSLATOR_TEXT_LIMIT 3000
+#define RESPONSE_LIMIT (16 * 1024)
+#define IO_TIMEOUT_SECONDS 120
+
+static int send_all(int fd, const char* data, size_t size)
+{
+    while (size > 0) {
+        ssize_t sent = send(fd, data, size, MSG_NOSIGNAL);
+        if (sent < 0 && errno == EINTR)
+            continue;
+        if (sent <= 0)
+            return -1;
+        data += sent;
+        size -= (size_t)sent;
+    }
+    return 0;
+}
+
+static char* json_escape(const char* text)
+{
+    size_t input_size = strlen(text);
+    if (input_size > TRANSLATOR_TEXT_LIMIT)
+        return NULL;
+    char* escaped = malloc(input_size * 6 + 1);
+    if (!escaped)
+        return NULL;
+    char* out = escaped;
+    for (const unsigned char* in = (const unsigned char*)text; *in; in++) {
+        if (*in == '"' || *in == '\\') {
+            *out++ = '\\';
+            *out++ = (char)*in;
+        } else if (*in < 0x20) {
+            int written = snprintf(out, 7, "\\u%04x", *in);
+            if (written != 6) {
+                free(escaped);
+                return NULL;
+            }
+            out += 6;
+        } else {
+            *out++ = (char)*in;
+        }
+    }
+    *out = '\0';
+    return escaped;
+}
+
+static int connect_translator(void)
+{
+    struct addrinfo hints = { 0 };
+    struct addrinfo* addresses = NULL;
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    int lookup = getaddrinfo(TRANSLATOR_HOST, TRANSLATOR_PORT, &hints, &addresses);
+    if (lookup != 0) {
+        WARN("Translator DNS lookup failed: %s", gai_strerror(lookup));
+        return -1;
+    }
+
+    int fd = -1;
+    for (struct addrinfo* address = addresses; address; address = address->ai_next) {
+        fd = socket(address->ai_family, address->ai_socktype, address->ai_protocol);
+        if (fd < 0)
+            continue;
+        struct timeval timeout = { IO_TIMEOUT_SECONDS, 0 };
+        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+        if (connect(fd, address->ai_addr, address->ai_addrlen) == 0)
+            break;
+        close(fd);
+        fd = -1;
+    }
+    freeaddrinfo(addresses);
+    return fd;
+}
+
+static int write_response_file(const char* body, size_t size)
+{
+    const char* temporary = "/tmp/piccap-translation-latest.json.tmp";
+    const char* latest = "/tmp/piccap-translation-latest.json";
+    FILE* file = fopen(temporary, "w");
+    if (!file)
+        return -1;
+    int result = fwrite(body, 1, size, file) == size && fputc('\n', file) != EOF ? 0 : -1;
+    if (fclose(file) != 0)
+        result = -1;
+    if (result == 0 && rename(temporary, latest) != 0)
+        result = -1;
+    if (result != 0)
+        unlink(temporary);
+    return result;
+}
+
+static bool request_translation(const char* text)
+{
+    INFO("Sending OCR text to Orange Pi (%zu bytes)", strlen(text));
+    char* escaped = json_escape(text);
+    if (!escaped) {
+        WARN("Translator request text is too large or could not be encoded");
+        return false;
+    }
+
+    size_t body_capacity = strlen(escaped) + 64;
+    char* body = malloc(body_capacity);
+    if (!body) {
+        free(escaped);
+        WARN("Translator request allocation failed");
+        return false;
+    }
+    int body_size = snprintf(body, body_capacity,
+        "{\"provider\":\"madlad\",\"text\":\"%s\"}", escaped);
+    free(escaped);
+    if (body_size < 0 || (size_t)body_size >= body_capacity) {
+        free(body);
+        WARN("Translator request serialization failed");
+        return false;
+    }
+
+    int fd = connect_translator();
+    if (fd < 0) {
+        WARN("Cannot connect to translator at %s:%s", TRANSLATOR_HOST, TRANSLATOR_PORT);
+        free(body);
+        return false;
+    }
+
+    char headers[512];
+    int header_size = snprintf(headers, sizeof(headers),
+        "POST %s HTTP/1.1\r\nHost: %s:%s\r\n"
+        "Content-Type: application/json; charset=utf-8\r\n"
+        "Connection: close\r\nContent-Length: %d\r\n\r\n",
+        TRANSLATOR_PATH, TRANSLATOR_HOST, TRANSLATOR_PORT, body_size);
+    int sent = header_size > 0 && (size_t)header_size < sizeof(headers)
+        ? send_all(fd, headers, (size_t)header_size) : -1;
+    if (sent == 0)
+        sent = send_all(fd, body, (size_t)body_size);
+    free(body);
+    if (sent != 0) {
+        WARN("Failed to send translator request");
+        close(fd);
+        return false;
+    }
+
+    char response[RESPONSE_LIMIT + 1];
+    size_t used = 0;
+    for (;;) {
+        ssize_t count = recv(fd, response + used, RESPONSE_LIMIT - used, 0);
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count <= 0)
+            break;
+        used += (size_t)count;
+        if (used == RESPONSE_LIMIT)
+            break;
+    }
+    close(fd);
+    response[used] = '\0';
+
+    char* body_start = strstr(response, "\r\n\r\n");
+    if (!body_start || (strncmp(response, "HTTP/1.0 200", 12) != 0
+            && strncmp(response, "HTTP/1.1 200", 12) != 0)) {
+        WARN("Translator returned invalid/failed HTTP response: %.*s",
+            240, response);
+        return false;
+    }
+    body_start += 4;
+    size_t response_size = used - (size_t)(body_start - response);
+    if (!response_size || response_size > RESPONSE_LIMIT) {
+        WARN("Translator returned an empty or oversized response");
+        return false;
+    }
+    if (write_response_file(body_start, response_size) != 0)
+        WARN("Could not save latest translator response: %s", strerror(errno));
+    INFO("TRANSLATION_RESPONSE %.*s", (int)response_size, body_start);
+    return true;
+}
+
+static void* worker_main(void* data)
+{
+    translator_worker_t* worker = data;
+    for (;;) {
+        pthread_mutex_lock(&worker->mutex);
+        while (!worker->pending && !worker->stopping)
+            pthread_cond_wait(&worker->condition, &worker->mutex);
+        if (worker->stopping) {
+            pthread_mutex_unlock(&worker->mutex);
+            break;
+        }
+        char* text = worker->text;
+        worker->text = NULL;
+        worker->pending = false;
+        free(worker->active_text);
+        worker->active_text = strdup(text);
+        pthread_mutex_unlock(&worker->mutex);
+        bool succeeded = request_translation(text);
+        pthread_mutex_lock(&worker->mutex);
+        if (succeeded) {
+            free(worker->last_text);
+            worker->last_text = strdup(text);
+        }
+        free(worker->active_text);
+        worker->active_text = NULL;
+        pthread_mutex_unlock(&worker->mutex);
+        free(text);
+    }
+    return NULL;
+}
+
+int translator_worker_start(translator_worker_t* worker)
+{
+    memset(worker, 0, sizeof(*worker));
+    if (pthread_mutex_init(&worker->mutex, NULL) != 0)
+        return -1;
+    if (pthread_cond_init(&worker->condition, NULL) != 0) {
+        pthread_mutex_destroy(&worker->mutex);
+        return -1;
+    }
+    if (pthread_create(&worker->thread, NULL, worker_main, worker) != 0) {
+        pthread_cond_destroy(&worker->condition);
+        pthread_mutex_destroy(&worker->mutex);
+        return -1;
+    }
+    worker->running = true;
+    INFO("Orange Pi translation worker started (%s:%s)", TRANSLATOR_HOST, TRANSLATOR_PORT);
+    return 0;
+}
+
+void translator_worker_submit(translator_worker_t* worker, const char* text)
+{
+    if (!worker->running || !text || !text[0])
+        return;
+    size_t size = strlen(text);
+    if (size > TRANSLATOR_TEXT_LIMIT)
+        size = TRANSLATOR_TEXT_LIMIT;
+    char* copy = strndup(text, size);
+    if (!copy)
+        return;
+
+    pthread_mutex_lock(&worker->mutex);
+    if (!worker->stopping && (!worker->last_text || strcmp(worker->last_text, copy) != 0)
+        && (!worker->active_text || strcmp(worker->active_text, copy) != 0)
+        && (!worker->text || strcmp(worker->text, copy) != 0)) {
+        free(worker->text);
+        worker->text = copy;
+        worker->pending = true;
+        copy = NULL;
+        pthread_cond_signal(&worker->condition);
+    }
+    pthread_mutex_unlock(&worker->mutex);
+    free(copy);
+}
+
+void translator_worker_stop(translator_worker_t* worker)
+{
+    if (!worker->running)
+        return;
+    pthread_mutex_lock(&worker->mutex);
+    worker->stopping = true;
+    pthread_cond_signal(&worker->condition);
+    pthread_mutex_unlock(&worker->mutex);
+    pthread_join(worker->thread, NULL);
+    pthread_cond_destroy(&worker->condition);
+    pthread_mutex_destroy(&worker->mutex);
+    free(worker->text);
+    free(worker->active_text);
+    free(worker->last_text);
+    memset(worker, 0, sizeof(*worker));
+}
diff --git a/unicapture/translator_worker.h b/unicapture/translator_worker.h
new file mode 100644
index 0000000..e12a9b5
--- /dev/null
+++ b/unicapture/translator_worker.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <pthread.h>
+#include <stdbool.h>
+
+typedef struct _translator_worker {
+    pthread_t thread;
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    bool running;
+    bool stopping;
+    bool pending;
+    char* text;
+    char* active_text;
+    char* last_text;
+} translator_worker_t;
+
+int translator_worker_start(translator_worker_t* worker);
+void translator_worker_submit(translator_worker_t* worker, const char* text);
+void translator_worker_stop(translator_worker_t* worker);
