+
+struct _frame_info;
+
+typedef struct _ocr_worker {
+    pthread_t thread;
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    bool enabled;
+    bool running;
+    bool stopping;
+    bool has_frame;
+    bool unsupported_format_logged;
