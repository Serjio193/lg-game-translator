diff --git a/src/socket_io.c b/src/socket_io.c
new file mode 100644
index 0000000..3f468dc
--- /dev/null
+++ b/src/socket_io.c
@@ -0,0 +1,51 @@
+#include "socket_io.h"
+#include <errno.h>
+#include <stdint.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <unistd.h>
+
+int socket_read_exact(int fd, void* buffer, size_t size)
+{
+    uint8_t* cursor = buffer;
+    while (size) {
+        ssize_t count = read(fd, cursor, size);
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count <= 0)
+            return -1;
+        cursor += count;
+        size -= (size_t)count;
+    }
+    return 0;
+}
+
+int socket_write_packet(int fd, const void* buffer, size_t size)
+{
+    if (size > UINT32_MAX)
+        return -1;
+    uint8_t header[] = { (uint8_t)(size >> 24), (uint8_t)(size >> 16),
+        (uint8_t)(size >> 8), (uint8_t)size };
+    struct iovec vectors[] = { { header, sizeof(header) }, { (void*)buffer, size } };
+    struct msghdr message = { 0 };
+    message.msg_iov = vectors;
+    message.msg_iovlen = 2;
+    while (message.msg_iovlen) {
+        ssize_t count = sendmsg(fd, &message, MSG_NOSIGNAL);
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count <= 0)
+            return -1;
+        size_t sent = (size_t)count;
+        while (message.msg_iovlen && sent >= message.msg_iov[0].iov_len) {
+            sent -= message.msg_iov[0].iov_len;
+            message.msg_iov++;
+            message.msg_iovlen--;
+        }
+        if (message.msg_iovlen && sent) {
+            message.msg_iov[0].iov_base = (uint8_t*)message.msg_iov[0].iov_base + sent;
+            message.msg_iov[0].iov_len -= sent;
+        }
+    }
+    return 0;
+}
