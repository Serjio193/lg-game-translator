diff --git a/unicapture/ocr_worker.c b/unicapture/ocr_worker.c
new file mode 100644
index 0000000..1261c56
--- /dev/null
+++ b/unicapture/ocr_worker.c
@@ -0,0 +1,357 @@
+#define _POSIX_C_SOURCE 200809L
+
+#include "ocr_worker.h"
+#include "ocr_diagnostics.h"
+#include "log.h"
+#include "unicapture.h"
+#include "utils.h"
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+
+#define OCR_INTERVAL_US 1000000ULL
+#define OCR_OUTPUT_LIMIT (256 * 1024)
+
+static int write_all(int fd, const uint8_t* data, size_t size)
+{
+    while (size > 0) {
+        ssize_t written = write(fd, data, size);
+        if (written < 0 && errno == EINTR)
+            continue;
+        if (written <= 0)
+            return -1;
+        data += written;
+        size -= (size_t)written;
+    }
+    return 0;
+}
+
+static int create_pgm(char* path, const uint8_t* pixels, int width, int height)
+{
+    int fd = mkstemp(path);
+    if (fd < 0)
+        return -1;
+
+    char header[64];
+    int header_size = snprintf(header, sizeof(header), "P5\n%d %d\n255\n", width, height);
+    int result = header_size > 0 && (size_t)header_size < sizeof(header)
+        ? write_all(fd, (const uint8_t*)header, (size_t)header_size)
+        : -1;
+    if (result == 0)
+        result = write_all(fd, pixels, (size_t)width * (size_t)height);
+    if (result == 0 && lseek(fd, 0, SEEK_SET) < 0)
+        result = -1;
+    if (result != 0) {
+        close(fd);
+        unlink(path);
+        return -1;
+    }
+    return fd;
+}
+
+static char* read_output(int fd)
+{
+    size_t size = 0;
+    size_t capacity = 4096;
+    char* output = malloc(capacity);
+    if (!output)
+        return NULL;
+
+    while (size < OCR_OUTPUT_LIMIT) {
+        if (size + 2048 + 1 > capacity) {
+            size_t next_capacity = capacity * 2;
+            if (next_capacity > OCR_OUTPUT_LIMIT + 1)
+                next_capacity = OCR_OUTPUT_LIMIT + 1;
+            char* next = realloc(output, next_capacity);
+            if (!next) {
+                free(output);
+                return NULL;
+            }
+            output = next;
+            capacity = next_capacity;
+        }
+        ssize_t count = read(fd, output + size, capacity - size - 1);
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count <= 0)
+            break;
+        size += (size_t)count;
+    }
+
+    char discard[4096];
+    for (;;) {
+        ssize_t count = read(fd, discard, sizeof(discard));
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count <= 0)
+            break;
+    }
+    output[size] = '\0';
+    return output;
+}
+
+static void log_tsv_words(char* output, uint64_t sequence)
+{
+    char* line = output;
+    bool found = false;
+    while (line && *line) {
+        char* next_line = strchr(line, '\n');
+        if (next_line)
+            *next_line++ = '\0';
+
+        char* fields[12];
+        fields[0] = line;
+        int field_count = 1;
+        for (char* cursor = line; *cursor && field_count < 12; cursor++) {
+            if (*cursor == '\t') {
+                *cursor = '\0';
+                fields[field_count++] = cursor + 1;
+            }
+        }
+
+        if (field_count == 12 && strcmp(fields[0], "level") != 0 && atoi(fields[0]) == 5 && fields[11][0]) {
+            int x = atoi(fields[6]);
+            int y = atoi(fields[7]);
+            int width = atoi(fields[8]);
+            int height = atoi(fields[9]);
+            double confidence = atof(fields[10]);
+            if (confidence >= 0.0) {
+                INFO("OCR_TEXT seq=%llu box=%d,%d,%d,%d confidence=%.1f text=%.*s",
+                    (unsigned long long)sequence, x, y, width, height, confidence, 160, fields[11]);
+                found = true;
+            }
+        }
+        line = next_line;
+    }
+    if (!found)
+        DBG("OCR_EMPTY seq=%llu", (unsigned long long)sequence);
+}
+
+static int run_tesseract(const uint8_t* pixels, int width, int height, uint64_t sequence,
+    uint64_t completed, uint64_t worker_started_us)
+{
+    uint64_t started_us = getticks_us();
+    char image_path[] = "/tmp/piccap-ocr-XXXXXX";
+    int image_fd = create_pgm(image_path, pixels, width, height);
+    if (image_fd < 0) {
+        WARN("OCR could not create temporary input: %s", strerror(errno));
+        return -1;
+    }
+
+    int output_pipe[2];
+    if (pipe(output_pipe) != 0) {
+        WARN("OCR could not create output pipe: %s", strerror(errno));
+        close(image_fd);
+        unlink(image_path);
+        return -1;
+    }
+
+    pid_t child = fork();
+    if (child == 0) {
+        close(output_pipe[0]);
+        if (dup2(image_fd, STDIN_FILENO) < 0 || dup2(output_pipe[1], STDOUT_FILENO) < 0)
+            _exit(126);
+        close(image_fd);
+        close(output_pipe[1]);
+        execl("/usr/bin/env", "env", "OMP_THREAD_LIMIT=1", "/usr/bin/nice", "-n", "10", "/usr/bin/tesseract",
+            "stdin", "stdout", "-l", "eng", "--psm", "11", "tsv", (char*)NULL);
+        _exit(127);
+    }
+
+    close(image_fd);
+    unlink(image_path);
+    close(output_pipe[1]);
+    if (child < 0) {
+        WARN("OCR could not start Tesseract: %s", strerror(errno));
+        close(output_pipe[0]);
+        return -1;
+    }
+
+    char* output = read_output(output_pipe[0]);
+    close(output_pipe[0]);
+    int status = 0;
+    pid_t waited;
+    do {
+        waited = waitpid(child, &status, 0);
+    } while (waited < 0 && errno == EINTR);
+
+    if (!output) {
+        WARN("OCR could not allocate Tesseract output buffer");
+        return -1;
+    }
+    if (waited != child || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+        WARN("Tesseract failed for frame %llu (status=%d)", (unsigned long long)sequence, status);
+        free(output);
+        return -1;
+    }
+
+    ocr_diagnostics_result(pixels, width, height, sequence, output,
+        (getticks_us() - started_us) / 1000.0, completed,
+        (getticks_us() - worker_started_us) / 1000000.0);
+    log_tsv_words(output, sequence);
+    free(output);
+    return 0;
+}
+
+static void* worker_main(void* data)
+{
+    ocr_worker_t* worker = data;
+    uint8_t* local_frame = NULL;
+    size_t local_capacity = 0;
+    uint64_t completed = 0;
+    uint64_t started_us = getticks_us();
+    for (;;) {
+        pthread_mutex_lock(&worker->mutex);
+        while (!worker->has_frame && !worker->stopping)
+            pthread_cond_wait(&worker->condition, &worker->mutex);
+        if (worker->stopping) {
+            pthread_mutex_unlock(&worker->mutex);
+            break;
+        }
+
+        int width = worker->width;
+        int height = worker->height;
+        uint64_t sequence = worker->sequence;
+        size_t size = (size_t)width * (size_t)height;
+        if (local_capacity < size) {
+            uint8_t* next = realloc(local_frame, size);
+            if (!next) {
+                worker->has_frame = false;
+                pthread_mutex_unlock(&worker->mutex);
+                WARN("OCR could not allocate worker frame");
+                continue;
+            }
+            local_frame = next;
+            local_capacity = size;
+        }
+        memcpy(local_frame, worker->frame, size);
+        worker->has_frame = false;
+        pthread_mutex_unlock(&worker->mutex);
+        if (run_tesseract(local_frame, width, height, sequence, completed + 1, started_us) == 0)
+            completed++;
+    }
+    free(local_frame);
+    return NULL;
+}
+
+int ocr_worker_start(ocr_worker_t* worker, bool enabled)
+{
+    memset(worker, 0, sizeof(*worker));
+    worker->enabled = enabled;
+    if (!enabled)
+        return 0;
+    if (access("/usr/bin/tesseract", X_OK) != 0 || access("/usr/share/tessdata/eng.traineddata", R_OK) != 0) {
+        WARN("OCR enabled but Tesseract English runtime/model is missing");
+        worker->enabled = false;
+        return 0;
+    }
+    if (pthread_mutex_init(&worker->mutex, NULL) != 0)
+        return -1;
+    if (pthread_cond_init(&worker->condition, NULL) != 0) {
+        pthread_mutex_destroy(&worker->mutex);
+        return -1;
+    }
+    if (pthread_create(&worker->thread, NULL, worker_main, worker) != 0) {
+        pthread_cond_destroy(&worker->condition);
+        pthread_mutex_destroy(&worker->mutex);
+        return -1;
+    }
+    worker->running = true;
+    INFO("OCR worker started (Tesseract 5, English, max 1 frame/s)");
+    return 0;
+}
+
+static int copy_frame_to_gray(const frame_info_t* frame, uint8_t* target)
+{
+    if (frame->pixel_format == PIXFMT_YUV420_SEMI_PLANAR || frame->pixel_format == PIXFMT_YUV420_PLANAR) {
+        int stride = frame->planes[0].stride;
+        if (!frame->planes[0].buffer || stride < frame->width)
+            return -1;
+        for (int y = 0; y < frame->height; y++)
+            memcpy(target + (size_t)y * frame->width, frame->planes[0].buffer + (size_t)y * stride, (size_t)frame->width);
+        return 0;
+    }
+
+    if (frame->pixel_format == PIXFMT_ARGB || frame->pixel_format == PIXFMT_ABGR || frame->pixel_format == PIXFMT_RGB) {
+        int bytes_per_pixel = frame->pixel_format == PIXFMT_RGB ? 3 : 4;
+        int stride = frame->planes[0].stride;
+        if (!frame->planes[0].buffer || stride < frame->width * bytes_per_pixel)
+            return -1;
+        for (int y = 0; y < frame->height; y++) {
+            const uint8_t* source = frame->planes[0].buffer + (size_t)y * stride;
+            uint8_t* destination = target + (size_t)y * frame->width;
+            for (int x = 0; x < frame->width; x++) {
+                const uint8_t* pixel = source + (size_t)x * bytes_per_pixel;
+                int red = frame->pixel_format == PIXFMT_ARGB ? pixel[2] : pixel[0];
+                int green = pixel[1];
+                int blue = frame->pixel_format == PIXFMT_ARGB ? pixel[0] : pixel[2];
+                destination[x] = (uint8_t)((77 * red + 150 * green + 29 * blue) >> 8);
+            }
+        }
+        return 0;
+    }
+    return -1;
+}
+
+void ocr_worker_submit(ocr_worker_t* worker, const struct _frame_info* source)
+{
+    const frame_info_t* frame = (const frame_info_t*)source;
+    if (!worker->enabled || !worker->running || !frame || frame->pixel_format == PIXFMT_INVALID)
+        return;
+    if (frame->width <= 0 || frame->height <= 0 || frame->width > 4096 || frame->height > 4096)
+        return;
+    uint64_t now = getticks_us();
+    if (now - worker->last_submit_us < OCR_INTERVAL_US)
+        return;
+
+    size_t size = (size_t)frame->width * (size_t)frame->height;
+    // Capture must not wait for the OCR consumer. A busy slot drops this sample.
+    if (pthread_mutex_trylock(&worker->mutex) != 0)
+        return;
+    if (worker->capacity < size) {
+        uint8_t* next = realloc(worker->frame, size);
+        if (!next) {
+            pthread_mutex_unlock(&worker->mutex);
+            WARN("OCR could not allocate queued frame");
+            return;
+        }
+        worker->frame = next;
+        worker->capacity = size;
+    }
+    if (copy_frame_to_gray(frame, worker->frame) != 0) {
+        if (!worker->unsupported_format_logged) {
+            WARN("OCR does not support captured pixel format %d", frame->pixel_format);
+            worker->unsupported_format_logged = true;
+        }
+        pthread_mutex_unlock(&worker->mutex);
+        return;
+    }
+    worker->width = frame->width;
+    worker->height = frame->height;
+    worker->sequence++;
+    if (worker->sequence == 1)
+        ocr_diagnostics_source(frame, getticks_us() - now);
+    worker->last_submit_us = now;
+    worker->has_frame = true;
+    pthread_cond_signal(&worker->condition);
+    pthread_mutex_unlock(&worker->mutex);
+}
+
+void ocr_worker_stop(ocr_worker_t* worker)
+{
+    if (!worker->running)
+        return;
+    pthread_mutex_lock(&worker->mutex);
+    worker->stopping = true;
+    pthread_cond_signal(&worker->condition);
+    pthread_mutex_unlock(&worker->mutex);
+    pthread_join(worker->thread, NULL);
+    pthread_cond_destroy(&worker->condition);
+    pthread_mutex_destroy(&worker->mutex);
+    free(worker->frame);
+    memset(worker, 0, sizeof(*worker));
+}
