diff --git a/tests/socket_io_test.c b/tests/socket_io_test.c
new file mode 100644
index 0000000..b33a3ee
--- /dev/null
+++ b/tests/socket_io_test.c
@@ -0,0 +1,84 @@
+#include "socket_io.h"
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#define FRAME_BYTES (1280 * 720 * 3)
+
+ssize_t __real_sendmsg(int fd, const struct msghdr* message, int flags);
+ssize_t __real_read(int fd, void* buffer, size_t size);
+
+ssize_t __wrap_sendmsg(int fd, const struct msghdr* message, int flags)
+{
+    static int calls;
+    if (++calls == 1) {
+        errno = EINTR;
+        return -1;
+    }
+    struct msghdr short_message = *message;
+    struct iovec part = message->msg_iov[0];
+    if (part.iov_len > 97)
+        part.iov_len = 97;
+    short_message.msg_iov = &part;
+    short_message.msg_iovlen = 1;
+    return __real_sendmsg(fd, &short_message, flags);
+}
+
+ssize_t __wrap_read(int fd, void* buffer, size_t size)
+{
+    static int calls;
+    if (++calls == 1) {
+        errno = EINTR;
+        return -1;
+    }
+    return __real_read(fd, buffer, size > 37 ? 37 : size);
+}
+
+static void* receiver(void* argument)
+{
+    int fd = *(int*)argument;
+    uint8_t* received = malloc(FRAME_BYTES);
+    assert(received);
+    for (int packet = 0; packet < 2; packet++) {
+        uint8_t header[4];
+        assert(socket_read_exact(fd, header, sizeof(header)) == 0);
+        uint32_t size = ((uint32_t)header[0] << 24) | ((uint32_t)header[1] << 16)
+            | ((uint32_t)header[2] << 8) | header[3];
+        assert(size == FRAME_BYTES);
+        assert(socket_read_exact(fd, received, size) == 0);
+        for (size_t i = 0; i < size; i++)
+            assert(received[i] == (uint8_t)(i + packet));
+    }
+    free(received);
+    return NULL;
+}
+
+int main(void)
+{
+    int pair[2];
+    assert(socketpair(AF_UNIX, SOCK_STREAM, 0, pair) == 0);
+    pthread_t thread;
+    assert(pthread_create(&thread, NULL, receiver, &pair[1]) == 0);
+    uint8_t* pixels = malloc(FRAME_BYTES);
+    assert(pixels);
+    for (int packet = 0; packet < 2; packet++) {
+        for (size_t i = 0; i < FRAME_BYTES; i++)
+            pixels[i] = (uint8_t)(i + packet);
+        assert(socket_write_packet(pair[0], pixels, FRAME_BYTES) == 0);
+    }
+    pthread_join(thread, NULL);
+    free(pixels);
+    close(pair[1]);
+    uint8_t byte;
+    assert(socket_read_exact(pair[0], &byte, 1) == -1);
+    assert(socket_write_packet(pair[0], &byte, 1) == -1);
+    close(pair[0]);
+    puts("PASS: two 720p RGB packets, partial I/O, EINTR, EOF, closed peer");
+    return 0;
+}
diff --git a/unicapture/ocr_diagnostics.c b/unicapture/ocr_diagnostics.c
new file mode 100644
index 0000000..e7760b1
--- /dev/null
+++ b/unicapture/ocr_diagnostics.c
@@ -0,0 +1,85 @@
+#include "ocr_diagnostics.h"
+#include "log.h"
+#include "unicapture.h"
+#include <stdio.h>
+
+static const char* format_name(pixel_format_t format)
+{
+    switch (format) {
+    case PIXFMT_RGB: return "RGB24";
+    case PIXFMT_ARGB: return "ARGB32-BGRA-bytes";
+    case PIXFMT_ABGR: return "ABGR32-RGBA-bytes";
+    case PIXFMT_YUV420_SEMI_PLANAR: return "NV12";
+    case PIXFMT_YUV420_PLANAR: return "I420";
+    default: return "other";
+    }
+}
+
+void ocr_diagnostics_source(const struct _frame_info* source, uint64_t copy_us)
+{
+    const frame_info_t* frame = source;
+    INFO("OCR_INPUT video-only %dx%d format=%s stride=%d gray_bytes=%zu copy_us=%llu",
+        frame->width, frame->height, format_name(frame->pixel_format),
+        frame->planes[0].stride, (size_t)frame->width * frame->height,
+        (unsigned long long)copy_us);
+    FILE* file = fopen("/tmp/piccap-ocr-input.txt", "w");
+    if (!file)
+        return;
+    fprintf(file, "source=video-only-before-UI\nwidth=%d\nheight=%d\nformat=%s\n"
+        "stride=%d\ntesseract_format=GRAY8-PGM\ntesseract_stride=%d\n"
+        "gray_bytes=%zu\ncopy_us=%llu\n",
+        frame->width, frame->height, format_name(frame->pixel_format),
+        frame->planes[0].stride, frame->width, (size_t)frame->width * frame->height,
+        (unsigned long long)copy_us);
+    fclose(file);
+}
+
+void ocr_diagnostics_output(const struct _frame_info* source)
+{
+    const frame_info_t* frame = source;
+    INFO("HYPERHDR_OUTPUT %dx%d format=%s stride=%d",
+        frame->width, frame->height, format_name(frame->pixel_format), frame->planes[0].stride);
+    if (frame->pixel_format != PIXFMT_RGB || !frame->planes[0].buffer)
+        return;
+    FILE* file = fopen("/tmp/piccap-hyperhdr-sample.ppm", "wb");
+    if (!file)
+        return;
+    fprintf(file, "P6\n%d %d\n255\n", frame->width, frame->height);
+    for (int y = 0; y < frame->height; y++)
+        fwrite(frame->planes[0].buffer + (size_t)y * frame->planes[0].stride,
+            1, (size_t)frame->width * 3, file);
+    fclose(file);
+}
+
+void ocr_diagnostics_result(const uint8_t* pixels, int width, int height,
+    uint64_t sequence, const char* tsv, double elapsed_ms, uint64_t completed, double uptime_s)
+{
+    INFO("OCR_RESULT seq=%llu input=%dx%d GRAY8 bytes=%zu elapsed_ms=%.1f",
+        (unsigned long long)sequence, width, height, (size_t)width * height, elapsed_ms);
+    FILE* stats = fopen("/tmp/piccap-ocr-status.txt", "w");
+    if (stats) {
+        fprintf(stats, "sequence=%llu\nwidth=%d\nheight=%d\nformat=GRAY8\n"
+            "bytes=%zu\nelapsed_ms=%.1f\ncompleted=%llu\nuptime_s=%.3f\nocr_fps=%.3f\n",
+            (unsigned long long)sequence, width, height, (size_t)width * height, elapsed_ms,
+            (unsigned long long)completed, uptime_s, uptime_s > 0 ? completed / uptime_s : 0);
+        fclose(stats);
+    }
+    FILE* latest = fopen("/tmp/piccap-ocr-latest.tsv", "w");
+    if (latest) {
+        fputs(tsv, latest);
+        fclose(latest);
+    }
+    if (sequence != 1)
+        return;
+    FILE* image = fopen("/tmp/piccap-ocr-sample.pgm", "wb");
+    if (image) {
+        fprintf(image, "P5\n%d %d\n255\n", width, height);
+        fwrite(pixels, 1, (size_t)width * height, image);
+        fclose(image);
+    }
+    FILE* sample = fopen("/tmp/piccap-ocr-sample.tsv", "w");
+    if (sample) {
+        fputs(tsv, sample);
+        fclose(sample);
+    }
+}
